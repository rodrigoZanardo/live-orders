{
  "name": "@live/web",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "e2e": "playwright test"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/lib"
    ],
    "transform": {
      "^.+[.]ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "esModuleInterop": true,
            "strict": true,
            "resolveJsonModule": true
          }
        }
      ]
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.14"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "next": "^15.5.4",
    "next-intl": "^4.3.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.63.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.11"
  }
}
