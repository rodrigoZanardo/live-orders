generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  VIEWER
}

model User {
  id           String    @id @db.Uuid
  email        String    @unique
  passwordHash String
  role         Role
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum OrderChannel {
  COUNTER
  DELIVERY_PLATFORM
}

enum EventType {
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  ORDER_LATE
}

model Order {
  id               String       @id @db.Uuid
  /// business day (YYYY-MM-DD in BUSINESS_TIME_ZONE) the order belongs to
  day              String
  number           Int
  customerName     String
  channel          OrderChannel
  status           OrderStatus
  version          Int
  statusChangedAt  DateTime
  lateSince        DateTime?
  externalId       String?
  deliveryCep      String?
  deliveryStreet   String?
  deliveryNumber   String?
  deliveryDistrict String?
  deliveryCity     String?
  deliveryState    String?
  createdAt        DateTime
  items            OrderItem[]
  events           Event[]
  idempotencyKeys  IdempotencyKey[]

  @@unique([day, number])
  @@unique([channel, externalId])
  @@index([createdAt])
}

model OrderItem {
  id       String @id @default(uuid()) @db.Uuid
  orderId  String @db.Uuid
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position Int
  sku      String
  name     String
  quantity Int

  @@index([orderId])
}

/// Last order number given out per business day; incremented atomically.
model DailyCounter {
  day  String @id
  last Int
}

/// Source of truth for the board and the audit trail; written in the same transaction as the change.
model Event {
  seq        BigInt       @id @default(autoincrement())
  type       EventType
  orderId    String       @db.Uuid
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  version    Int
  actorEmail String
  createdAt  DateTime     @default(now())

  @@index([orderId])
}

/// Incoming webhook dedupe: the same key twice returns the first order. Deleted after 7 days.
model IdempotencyKey {
  key       String   @id
  orderId   String   @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Outgoing webhooks: every order event is POSTed, signed with the subscription's own secret.
model WebhookSubscription {
  id         String            @id @db.Uuid
  url        String
  secret     String
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model WebhookDelivery {
  id             String              @id @default(uuid()) @db.Uuid
  subscriptionId String              @db.Uuid
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventSeq       BigInt
  eventType      EventType
  /// the exact JSON body sent on every attempt
  payload        String
  status         DeliveryStatus      @default(PENDING)
  attempts       Int                 @default(0)
  lastError      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, createdAt])
}
