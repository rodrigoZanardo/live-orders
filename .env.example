# Copy to .env and adjust. Never commit .env.

# PostgreSQL connection (api)
DATABASE_URL=postgresql://live:live@localhost:5433/live_orders

# IANA time zone that decides the business day; daily order numbers restart at its midnight
BUSINESS_TIME_ZONE=America/Sao_Paulo

# HS256 signing secret for login tokens (api). Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-secret

# First admin, created on the first start when the email does not exist yet (api)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# API port and the web origin allowed by CORS (api)
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Redis for pub/sub between API instances and the job queues (api)
REDIS_URL=redis://localhost:6380

# Minutes an order may stay in PREPARING before the board flags it late (api)
LATE_AFTER_MINUTES=10

# Shared secret the delivery platform signs incoming orders with (api, scripts/delivery-platform.mjs)
WEBHOOK_INCOMING_SECRET=change-me-incoming-webhook-secret

# Shared secret the delivery platform signs incoming orders with (api, scripts/delivery-platform.mjs)
WEBHOOK_INCOMING_SECRET=change-me-incoming-webhook-secret

# Web: where the server reaches the API, and where the browser reaches it (WebSocket + catch-up)
API_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3001

# Web: set to false to allow the session cookie over plain http outside localhost
COOKIE_SECURE=false

# Optional demo account (api creates it as STAFF; web shows it on the sign-in page). Never the admin.
DEMO_EMAIL=
DEMO_PASSWORD=

# Stock service the API checks counter orders against and the customer screen (/cliente) reads products from,
# signed in as a VIEWER user there (the token is fetched and renewed by the app). Server only: never prefix them with NEXT_PUBLIC_.
# The defaults point at the stub in docker-compose (scripts/stock-stub.mjs). Outside Docker, run
# `node scripts/stock-stub.mjs` and use STOCK_API_URL=http://localhost:3040. For the real Stock Manager, use its
# gateway or port (http://localhost:3031 or http://localhost:3033 when run locally) and its VIEWER user
# (VIEWER_EMAIL / VIEWER_PASSWORD in Stock Manager).
STOCK_API_URL=http://stock-stub:3040
STOCK_API_EMAIL=viewer@example.com
STOCK_API_PASSWORD=viewer-password
