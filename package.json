{
  "name": "live-orders",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "test": "npm test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --ignore-pattern **/next-env.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "docker compose up --build -d && echo 'App: http://localhost:3000  login admin@example.com / admin-password  API docs: http://localhost:3001/docs'",
    "stop": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
